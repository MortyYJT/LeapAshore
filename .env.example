NEXT_PUBLIC_API_URL=http://localhost:8000
# Vercel Services injects NEXT_PUBLIC_API_URL=/api automatically for the api service.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Hosted fast path: only the server operator configures this key; end users never provide one.
AGENT_MODE=deterministic-demo
LLM_PROVIDER=deterministic
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
ADVISOR_DAILY_LIMIT=30

# Optional offline mode. It is never used as an implicit DeepSeek fallback.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:0.5b

CORS_ORIGINS=http://localhost:3000
SESSION_TTL_HOURS=168
APP_ENV=development
EXPOSE_DEBUG_TOKENS=true
APP_URL=http://localhost:8080
ADMIN_EMAILS=admin@offerpilot.local
AUTH_RATE_LIMIT_PER_MINUTE=20
RATE_LIMIT_PER_MINUTE=120
# Only enable when the API is reachable exclusively through deploy/Caddyfile.
TRUST_PROXY_HEADERS=false
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
APP_RELEASE=offerpilot-api@0.4.0
METRICS_BEARER_TOKEN=
TELEMETRY_SPAN_SAMPLE_RATE=1.0

# Required in production for verification and password-reset email.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=OfferPilot <no-reply@example.com>
SMTP_USE_TLS=true

# Set this to persist users, profiles and Agent runs across API restarts.
DATABASE_PATH=./data/offerpilot.db
# Production takes precedence over DATABASE_PATH when both are present.
DATABASE_URL=

# Optional MewHelp-compatible Agent services. Replace placeholders with generated secrets before enabling.
MYSQL_AGENT_URL=
MYSQL_AGENT_PASSWORD=replace-before-start
MYSQL_AGENT_ROOT_PASSWORD=replace-before-start
MYSQL_AGENT_CONNECT_TIMEOUT=3
MYSQL_AGENT_POOL_SIZE=5
MILVUS_URI=http://milvus-agent:19530
MILVUS_TOKEN=
MILVUS_COLLECTION=offerpilot_knowledge_v1
MILVUS_EMBEDDING_DIMENSIONS=1024
MILVUS_MINIO_ROOT_USER=replace-before-start
MILVUS_MINIO_ROOT_PASSWORD=replace-before-start
EMBEDDING_BASE_URL=http://embedding-agent/v1
EMBEDDING_MODEL=bge-m3
EMBEDDING_API_KEY=local-tei-only
RERANKER_BASE_URL=http://reranker-agent
TEI_CPU_IMAGE=ghcr.io/huggingface/text-embeddings-inference:cpu-1.9
MCP_SERVER_URL=http://mcp-agent:8765/mcp
MCP_ENABLED=false
