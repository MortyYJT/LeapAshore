# Copy to deploy/.env on the server and fill in. Never commit the filled-in file.
POSTGRES_PASSWORD=change-me

# OpenAI-compatible chat endpoint for the advisor agent.
CHAT_BASE_URL=https://api.deepseek.com
CHAT_MODEL=deepseek-chat
CHAT_API_KEY=
# Output cap per model call (sent as max_tokens); the intent router has its own smaller cap.
# CHAT_MAX_TOKENS=1500
# INTENT_MAX_TOKENS=200

# Advisor limits (openspec/changes/advisor-limits). Defaults shown; REDIS_URL and TRUSTED_PROXIES are
# set in compose.prod.yaml. Windows are requests/seconds, comma-separated; days are Beijing days.
# ADVISOR_SUBJECT_LIMITS=10/60,60/3600
# ADVISOR_IP_LIMITS=30/60,200/3600
# ADVISOR_DAILY_TOKENS_PER_SUBJECT=200000
# ADVISOR_DAILY_TOKENS_PER_IP=600000
# ADVISOR_DAILY_TOKENS_SITE=2000000
# Held on the day counters while a turn runs, returned when it ends.
# ADVISOR_TURN_TOKEN_RESERVE=8000

# Accounts (openspec/changes/account-login). Leave AUTH_ENABLED unset until the SES sender domain is
# verified and the SMTP password below works; with it on, the API refuses to start without them.
# AUTH_ENABLED=true
# MAIL_BACKEND=smtp
# Tencent Cloud SES SMTP: smtp.qcloudmail.com (Hong Kong) or gz-smtp.qcloudmail.com (Guangzhou), 465 SSL.
# SMTP_HOST=smtp.qcloudmail.com
# SMTP_PORT=465
# SMTP_USER=noreply@mail.mortyyjt.site
# SMTP_PASSWORD=
# MAIL_FROM=鱼跃彼岸 <noreply@mail.mortyyjt.site>

# Collection queue (openspec/changes/collect-queue). Defaults shown; the broker URL is set in
# compose.prod.yaml. The beat re-collects pages not fetched for COLLECT_RECOLLECT_DAYS, at most
# COLLECT_RECOLLECT_PER_DAY a day, and stops calling the model once the day's spend (Beijing day, CNY,
# DeepSeek peak price) reaches COLLECT_DAILY_BUDGET_CNY.
# COLLECT_RECOLLECT_DAYS=30
# COLLECT_RECOLLECT_PER_DAY=200
# COLLECT_DAILY_BUDGET_CNY=1.0

# Hybrid retrieval (openspec/changes/hybrid-retrieval). Without EMBED_API_KEY the advisor ranks by
# full text only and sends nothing to SiliconFlow. With it, every requirement question's text is sent
# to SiliconFlow to be embedded, so update the privacy page in the same change (note/handoff.md).
# After setting it: `python -m app.agent.embeddings` in the api container fills the vectors once; the
# beat keeps them current hourly. BAAI/bge-m3 is listed as free on siliconflow.cn/pricing (2026-10-30).
# EMBED_API_KEY=
# EMBED_MODEL=BAAI/bge-m3
# ADVISOR_RETRIEVAL=hybrid
