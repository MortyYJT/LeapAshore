# Addressing the site by hostname turns on Caddy's automatic HTTPS: it obtains and renews the
# certificate itself and redirects plain HTTP to HTTPS. Certificates persist in the caddy-data volume.
leapashore.mortyyjt.site {
	encode gzip
	handle /api/* {
		reverse_proxy api:8000 {
			# Streamed agent replies must reach the browser as they are produced.
			flush_interval -1
			# The API counts advisor limits against this address and reads it only from this proxy
			# (TRUSTED_PROXIES). Set, not appended, so a client's own X-Forwarded-For never reaches it.
			header_up X-Forwarded-For {remote_host}
		}
	}
	handle {
		reverse_proxy web:3000
	}
}

# Links that still point at the bare IP land on the domain, so the client cookie stays on one origin.
http://43.161.224.82 {
	redir https://leapashore.mortyyjt.site{uri} permanent
}

# The owner's personal website (MortyYJT/personal-website-guyuy) shares this Caddy because it holds
# ports 80 and 443. Its GitHub Actions workflow rsyncs a Next.js static export into /srv/mortyyjt.site
# through a key that rrsync confines to that directory; nothing here depends on LeapAshore.
mortyyjt.site {
	root * /srv/mortyyjt.site
	encode zstd gzip
	# Hashed build assets never change under the same name.
	header /_next/static/* Cache-Control "public, max-age=31536000, immutable"
	# The export writes /projects as projects.html next to a projects/ data directory, so try the
	# .html file before the bare path.
	try_files {path}.html {path} {path}/index.html
	file_server
	handle_errors 404 {
		rewrite * /404.html
		file_server
	}
}

www.mortyyjt.site {
	redir https://mortyyjt.site{uri} permanent
}
