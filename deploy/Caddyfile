# Addressing the site by hostname turns on Caddy's automatic HTTPS: it obtains and renews the
# certificate itself and redirects plain HTTP to HTTPS. Certificates persist in the caddy-data volume.
leapashore.mortyyjt.site {
	encode gzip
	handle /api/* {
		reverse_proxy api:8000 {
			# Streamed agent replies must reach the browser as they are produced.
			flush_interval -1
		}
	}
	handle {
		reverse_proxy web:3000
	}
}

# Links that still point at the bare IP land on the domain, so the client cookie stays on one origin.
http://43.161.224.82 {
	redir https://leapashore.mortyyjt.site{uri} permanent
}
